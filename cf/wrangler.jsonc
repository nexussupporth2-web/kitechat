{
  // KiteChat on Cloudflare: TEST COPY (phase 1). Render is not touched.
  "name": "kitechat-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "kitechat" }]
}
